#include "toucan.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
    = <&gpio1 12 GPIO_ACTIVE_HIGH>
    , <&gpio1 11 GPIO_ACTIVE_HIGH>
    , <&gpio0 5 GPIO_ACTIVE_HIGH>
    , <&gpio0 10 GPIO_ACTIVE_HIGH>
    , <&gpio0 4 GPIO_ACTIVE_HIGH>
    , <&gpio0 9 GPIO_ACTIVE_HIGH>
    ;

    row-gpios
    = <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    ;
};

&pinctrl {
    i2c0_azoteq_default: i2c0_azoteq_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 13)>,
                    <NRF_PSEL(TWIM_SCL, 1, 15)>;
            bias-pull-up;
        };
    };

    i2c0_azoteq_sleep: i2c0_azoteq_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 13)>,
                    <NRF_PSEL(TWIM_SCL, 1, 15)>;
            low-power-enable;
        };
    };
};

&i2c0 {
   status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c0_azoteq_default>;
    pinctrl-1 = <&i2c0_azoteq_sleep>;
   pinctrl-names = "default", "sleep";

    tps43_trackpad: trackpad@74 {
        compatible = "azoteq,tps43";
        reg = <0x74>;
        status = "okay";

        rst-gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
        rdy-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;

        enable-power-management;

        /* Cursor feel: base sensitivity stays at 50 (the driver carries the
           sub-unit rounding remainder so slow/fine moves still register). On top
           of this, macOS-like pointer acceleration scales the gain by finger
           speed: slow strokes get finer control, fast flicks reach across the
           screen. The curve is centered so mid-speed feel is ~unchanged. */
        sensitivity = <50>;
        pointer-acceleration;
        accel-min-gain = <60>;       /* fine control at very low speed */
        accel-max-gain = <240>;      /* fast flick-to-edge */
        accel-slow-threshold = <3>;
        accel-fast-threshold = <20>;

        /* 2-finger scroll. The driver now carries a per-axis sub-detent remainder
           and emits BOTH axes (fluid/diagonal), so a higher sensitivity no longer
           jumps. The listener's zip_scroll_scaler (toucan.dtsi) smooths further. */
        scroll-sensitivity = <55>;
        zoom-sensitivity = <50>;

        /* Fast active report rate (ms) is the biggest single smoothness lever:
           100 Hz while tracking, with a quick idle-touch rate so a resting finger
           stays responsive. Back off (e.g. 13) if logs show TPS43_RR_MISSED. */
        report-rate-active = <10>;
        report-rate-idle-touch = <16>;

        filter-settings=<0x0B>;

        /* Tap / hold timing for a snappier, more macOS-like click and drag. */
        tap-time = <180>;
        hold-time = <300>;

        /* Pinch-to-zoom: emits one momentary press+release per zoom step
           (default codes shown). zoom-step is the accumulated magnitude needed
           to fire one step - larger = coarser. Map these on the host as you
           like (e.g. Ctrl+= / Ctrl+-). Requires the `zoom` gesture below. */
        zoom-in-code = <INPUT_BTN_4>;
        zoom-out-code = <INPUT_BTN_5>;
        zoom-step = <30>;

        /* 3-finger swipes: latched + threshold-based, so each swipe fires
           exactly once and uses codes distinct from the 1-finger swipe codes
           (NORTH/SOUTH/EAST/WEST) so the host can tell them apart. Requires the
           `swipes` gesture below. Tune the threshold (raw travel) to taste. */
        three-finger-swipe-up-code = <INPUT_BTN_6>;
        three-finger-swipe-down-code = <INPUT_BTN_7>;
        three-finger-swipe-left-code = <INPUT_BTN_8>;
        three-finger-swipe-right-code = <INPUT_BTN_9>;
        /* Lowered so a normal-length 3-finger swipe fires reliably once. The
           driver now keeps accumulating across a transient 4th-finger brush
           (counts >= 3) instead of resetting, so the latch is more dependable. */
        three-finger-swipe-threshold = <120>;

        scroll;
        two-finger-tap;
        single-tap;
        press-and-hold;
        swipes;
        zoom;

        switch-xy;
        invert-scroll-y;
    };
};

&glidepoint_split {
    device = <&tps43_trackpad>;
};
